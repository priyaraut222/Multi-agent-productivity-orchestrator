# ============ Multi-Agent Productivity & Goal Orchestration System ============
# Copy to .env.  EVERYTHING below is free.  You can start with nothing at all:
# without any key the app runs in "Offline demo mode" (rule-based, limited).

# Used to encrypt stored API keys / OAuth tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=change-me
TIMEZONE=Asia/Kolkata

# ---- Pick ONE primary LLM provider (all have free tiers). Others with a key act as automatic fallbacks. ----
LLM_PROVIDER=groq              # groq | gemini | openrouter | ollama | offline
GROQ_API_KEY=                  # https://console.groq.com/keys
GEMINI_API_KEY=                # https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=            # https://openrouter.ai/keys
# Model names change over time - override if a provider retires one:
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OLLAMA_MODEL=llama3.1:8b      # fully local, no internet needed (https://ollama.com)

# ---- Optional integrations ----
GOOGLE_CLIENT_ID=              # Google Cloud Console -> OAuth client (Web). Redirect URI = REDIRECT_URL
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=              # optional; a personal access token pasted in the UI is simpler
GITHUB_CLIENT_SECRET=
REDIRECT_URL=

# ---- Agent limits / defaults ----
# MAX_WORKER_STEPS=6
# WORK_START=09:00
# WORK_END=18:00
